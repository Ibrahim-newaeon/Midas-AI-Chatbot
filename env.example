MAGENTO_GRAPHQL_URL=https://midasfurniture.com/graphql
# Mirror rehearsal GraphQL is in-process at /api/graphql when the widget sends catalog=mirror
# Optional: used only to describe uploaded photos before catalog search
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Send-gate stale-facts window. Spec wants Magento MSI p95; 120000 is a rehearsal default until that is measured.
TRUTH_TTL_MS=120000
# CORS origin when Magento hosts the embed script
WIDGET_ORIGIN=https://midasfurniture.com
# Optional L4 vector index. Copy-only (SKU + name + categories). Magento remains price/stock truth.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
# Optional. If unset, retrieval uses local hashed n-gram embeddings (no network).
OPENAI_EMBEDDING_MODEL=
# Bake-off / future primary engine. Live chat stays `rules` until the golden set stays green.
MIDAS_PRIMARY_ENGINE=rules
OPENAI_CHAT_MODEL=
